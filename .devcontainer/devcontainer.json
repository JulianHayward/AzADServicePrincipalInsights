{
	"name": "AzADServicePrincipalInsights",
	//the mcr.microsoft.com/powershell images end with PowerShell 7.5; PowerShell comes from the devcontainers feature instead
	"image": "mcr.microsoft.com/devcontainers/base:2-ubuntu-24.04",
	"features": {
		"ghcr.io/devcontainers/features/powershell:2": {
			"version": "7.6",
			//AzAPICall version = default of the script's -azAPICallVersion parameter
			"modules": "Az.Accounts,AzAPICall==1.4.2"
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "pwsh"
			},
			"extensions": [
				"ms-vscode.powershell",
				"bierner.markdown-mermaid",
				"ms-vscode.live-server",
				"github.vscode-github-actions"
			]
		}
	},
	"forwardPorts": []
}
